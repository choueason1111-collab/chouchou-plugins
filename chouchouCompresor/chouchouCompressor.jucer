<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="cCp1ju" name="chouchouCompressor" projectType="audioplug" useAppConfig="0"
              addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1"
              pluginName="chouchouCompressor" pluginDesc="Dual-threshold spectral compressor — weak up, strong down, mid unchanged"
