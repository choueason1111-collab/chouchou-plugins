Param lowDb(-50);
Param highDb(-18);
Param upRatio(2);
Param downRatio(4);
Param mix(1);
Param makeupDb(0);
eps = 1e-8;
env = max(in1, eps);
mag = in2;
lowLin = pow(10, lowDb * 0.05);
highLin = pow(10, highDb * 0.05);
envDb = 20 * log10(env);
upSlope = 1 - 1 / max(upRatio, 1);
dnSlope = 1 - 1 / max(downRatio, 1);
gainUp = pow(10, ((lowDb - envDb) * upSlope) * 0.05);
gainDn = pow(10, ((highDb - envDb) * dnSlope) * 0.05);
gain = (env < lowLin) ? gainUp : ((env > highLin) ? gainDn : 1);
gain = clip(gain, 1e-4, 32);
gain = (1 - mix) + mix * (gain * pow(10, makeupDb * 0.05));
out1 = mag * gain;
